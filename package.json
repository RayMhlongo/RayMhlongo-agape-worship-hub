{
  "name": "agape-worship-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:mobile": "cross-env CAPACITOR_EXPORT=1 next build",
    "android:add": "cap add android",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "cap open android",
    "android:apk:debug": "npm run android:sync && cd android && gradlew assembleDebug",
    "android:apk:release": "npm run android:sync && cd android && gradlew assembleRelease",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@dnd-kit/core": "latest",
    "@dnd-kit/sortable": "latest",
    "@dnd-kit/utilities": "latest",
    "@google/generative-ai": "latest",
    "@react-pdf/renderer": "latest",
    "clsx": "latest",
    "cross-env": "^10.1.0",
    "date-fns": "latest",
    "firebase": "^12.13.0",
    "framer-motion": "latest",
    "jspdf": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "next-pwa": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
